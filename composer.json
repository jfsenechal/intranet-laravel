        "acmarche/aldermen-agenda": "*@dev",
        "acmarche/app": "*@dev",
        "acmarche/college": "*@dev",
        "acmarche/conseil": "*@dev",
        "acmarche/courrier": "*@dev",
        "acmarche/cpas-library": "*@dev",
        "acmarche/document": "*@dev",
        "acmarche/email-management": "*@dev",
        "acmarche/guichet-hdv": "*@dev",
        "acmarche/hrm": "*@dev",
        "acmarche/issep": "*@dev",
        "acmarche/mailing-list": "*@dev",
