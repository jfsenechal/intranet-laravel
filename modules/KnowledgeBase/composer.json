{
    "name": "acmarche/knowledge-base",
    "description": "IT knowledge base (Markdown) for AcMarche",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "AcMarche",
            "email": "info@acmarche.be"
        }
    ],
    "require": {
        "php": "^8.5",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^12.0|^13.0",
        "phiki/phiki": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "AcMarche\\KnowledgeBase\\": "src/",
            "AcMarche\\KnowledgeBase\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AcMarche\\KnowledgeBase\\Providers\\KnowledgeBaseServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
