        "intervention/validation": "^4.7.0",
        "laravel-notification-channels/webpush": "^13.0.0",
        "laravel/ai": "^v1.2.0",
        "laravel/framework": "^13.0",
        "laravel/nightwatch": "^v1.30",
        "laravel/octane": "^v2.21.0",
        "laravel/reverb": "^v1.12.0",
        "laravel/sanctum": "^v4.3",
        "laravel/scout": "^v11.9",
        "laravel/tinker": "^v3.0.2",
        "meilisearch/meilisearch-php": "^v1.17.0",
        "nunomaduro/essentials": "^v1.2.0",
        "psy/psysh": "^0.12.19",
        "secondnetwork/blade-tabler-icons": "^v3.49.0",
        "simplesoftwareio/simple-qrcode": "^4.2.0",
        "spatie/browsershot": "^5.4.0",
        "spatie/laravel-pdf": "^2.14.0",
        "spatie/laravel-sluggable": "^4.0.3",
        "spiral/roadrunner-cli": "^v2.7.2",
        "spiral/roadrunner-http": "^v4.1.0",
        "stechstudio/filament-impersonate": "^v5.6.1",
        "symfony/process": "^7.4.5 || ^8.0.5",
        "tangodev-it/filament-emoji-picker": "^3.0.0"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.6.2",
        "fakerphp/faker": "^1.23",
        "filament/blueprint": "^2.4.0",
        "fruitcake/laravel-debugbar": "^v4.4.4",
        "larastan/larastan": "^v3.13.0",
        "laravel/boost": "^v2.10.3",
        "laravel/pail": "^v1.2.7",
        "laravel/pao": "^v1.1.5",
        "laravel/pint": "^v1.32.1",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^v8.9.5",
        "pestphp/pest": "^v4.3.0",
        "pestphp/pest-plugin-browser": "v4.0.3",
        "pestphp/pest-plugin-faker": "^v4.0.0",
        "pestphp/pest-plugin-laravel": "^v4.0.0",
        "pestphp/pest-plugin-livewire": "^v4.0.1",
        "phpunit/phpunit": "^12.5.8",
        "rector/rector": "^2.7.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan app:welcome",
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi",
            "@php artisan db:seed --ansi",
            "npm install",
            "npm install playwright@latest",
            "npx playwright install",
            "npm run build",
            "@php cleanup.php"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74,#67e8f9\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" \"php artisan reverb:start\" --names=server,queue,logs,vite,reverb"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "pest": "./vendor/bin/pest --parallel",
        "rector": "./vendor/bin/rector process --ansi",
        "pint": "./vendor/bin/pint",
        "phpstan": "./vendor/bin/phpstan analyse",
        "review": [
            "@pint",
            "@rector",
            "@phpstan",
            "@pest"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
